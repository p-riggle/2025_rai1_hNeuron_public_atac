NPCG1 = "c4",
IPC = "c6",
Neuron = "c1",
Astro = "c5"
)
# 2. Use nested loops to iterate through all combinations
for (comp in comparisons) {
for (cell in names(variables_to_save)) {
cell_code <- variables_to_save[[cell]]
# A. Construct the R object name (e.g., "rstbl_NPCG2M_wt.vs.het")
object_name <- paste0("rstbl_", cell, "_", comp)
# B. Construct the output file path (e.g., "results/.../rstbl_c0_wt.vs.het.csv")
file_path <- paste0("results/scRNAseq/7_pseudobulk/rstbl_", cell_code, "_", comp, ".csv")
# C. Get the data object using get()
# NOTE: This assumes the object (e.g., rstbl_NPCG2M_wt.vs.het) exists in your global environment.
data_to_write <- get(object_name)
# D. Write the file
write.csv(as.data.frame(data_to_write), file = file_path)
# Print a confirmation (optional)
cat("Saved:", object_name, "to", file_path, "\n")
}
}
