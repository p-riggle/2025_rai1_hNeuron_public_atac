install.packages("rlang")
library(DESeq2)
library(tidyverse)
library(DESeq2)
library(tidyverse)
setwd("/nfs/turbo/umms-siwase/SHIGEKI2/rai1_hesc")
# read dds object generated by pesudobulk analysis
dds_both <- readRDS("data/scRNAseq/iwaselab/dds_both")
head(dds_both)
# transform data
vsd_dds_both <- vst(dds_both, blind = TRUE)
head(assay(vsd_dds_both), 3)
# from the vsd_dds_both, make a data frame of expression values with 1) genotype, 2) replicate, 3) day, and 4) cell type
vsd_long <- as.data.frame(assay(vsd_dds_both)) %>%
rownames_to_column(var = "gene") %>%
pivot_longer(-gene, names_to = "sample_id", values_to = "expression") %>%
separate(
sample_id,
into = c("day_raw", "genotype", "replicate_celltype"),
sep = "-",
remove = FALSE
) %>%
separate(
replicate_celltype,
into = c("replicate", "cell_type"),
sep = "_",
extra = "merge"
) %>%
mutate(
day = as.numeric(gsub("day", "", day_raw))
) %>%
select(gene, day, genotype, replicate, cell_type, expression)
head(vsd_long)
head(assay(vsd_dds_both), 3)
# from the vsd_dds_both, make a data frame of expression values with 1) genotype, 2) replicate, 3) day, and 4) cell type
vsd_long <- as.data.frame(assay(vsd_dds_both)) %>%
rownames_to_column(var = "gene") %>%
pivot_longer(-gene, names_to = "sample_id", values_to = "expression") %>%
# Use extract() to define exactly what each part looks like
# ([^-]+) means "match everything until the next hyphen"
extract(
sample_id,
into = c("day_raw", "genotype", "replicate_celltype"),
regex = "^([^-]+)-([^-]+)-(.*)$",
remove = FALSE
) %>%
separate(
replicate_celltype,
into = c("replicate", "cell_type"),
sep = "_",
extra = "merge"
) %>%
mutate(
day = as.numeric(gsub("day", "", day_raw))
) %>%
select(gene, day, genotype, replicate, cell_type, expression)
vsd_long(head)
head(vsd_long)
# load the cluster from bulk-RNAseq analysis
hcl_het <- read.table("results/cn_rnaseq/cluster/sep/mh_het_2026.04.13.txt", sep = "\t", header = TRUE, row.names = 1)
head(hcl_het)
hcl_ko <- read.table("results/cn_rnaseq/cluster/sep/mh_ko_2026.04.13.txt", sep = "\t", header = TRUE, row.names = 1)
head(hcl_ko)
# extract cluster 1 genes from hcl_het
cluster1_genes <- unique(hcl_het$gene[hcl_het$cluster == 1])
head(cluster1_genes)
# 1. & 2. (Your previous steps are fine)
genes_to_keep <- intersect(cluster1_genes, vsd_long$gene)
# 3. FIX: Use filter() or %in% to subset the rows based on the gene column
vsd_cluster1 <- vsd_long %>%
filter(gene %in% genes_to_keep)
# 2. Check how many genes were lost (optional but helpful)
message("Found ", length(genes_to_keep), " out of ", length(cluster1_genes), " genes.")
# violin plot the expression of cluster 1 genes across cell types
ggplot(vsd_cluster1, aes(x = cell_type, y = expression)) +
geom_violin(fill = "steelblue") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
labs(title = "Expression of Cluster 1 Genes Across Cell Types", x = "Cell Type", y = "Expression")
# 1. Define your custom color palette as a named vector
cell_colors <- c(
"NPC-G2/M" = "hotpink",
"Mes-WT"   = "forestgreen",
"Mes-KO"   = "yellowgreen",
"NPC-G1"   = "purple",
"IPC"      = "gold",
"Neuron"   = "dodgerblue",
"gRG"      = "orangered"
)
# 2. Update vsd_cluster1 to set the order of cell_type
vsd_cluster1 <- vsd_cluster1 %>%
mutate(cell_type = factor(cell_type, levels = names(cell_colors)))
# 3. Plot with scale_fill_manual
ggplot(vsd_cluster1, aes(x = cell_type, y = expression, fill = cell_type)) +
geom_violin(alpha = 0.8) + # Added alpha so colors aren't too overwhelming
scale_fill_manual(values = cell_colors) +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "none" # Optional: hide legend since axis labels explain the colors
) +
labs(
title = "Expression of Cluster 1 Genes Across Cell Types",
x = "Cell Type",
y = "Expression"
)
ggplot(vsd_cluster1, aes(x = cell_type, y = expression, fill = cell_type)) +
# 1. The Violin layer
geom_violin(alpha = 0.7) +
# 2. The Boxplot layer (narrowed with a white median line or black)
geom_boxplot(width = 0.1, color = "black", outlier.shape = NA) +
scale_fill_manual(values = cell_colors) +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "none"
) +
labs(
title = "Expression of Cluster 1 Genes Across Cell Types",
subtitle = "Violin plots with internal boxplots (Log10 scale)",
x = "Cell Type",
y = "Expression"
)
