# extract genes that are upregulated only in one timepoint
unique_up_genes <- list()
for (tp in timepoints) {
  other_tps <- setdiff(timepoints, tp)
  other_genes <- unlist(lapply(other_tps, function(otp) as.character(deg_tibbles[[paste0("up_", otp, "_ko")]]$gene)))
  unique_genes <- setdiff(as.character(deg_tibbles[[paste0("up_", tp, "_ko")]]$gene), other_genes)
  unique_up_genes[[tp]] <- unique_genes
}
unique_up_genes

# count number of unique up genes at each timepoint
unique_up_counts <- sapply(unique_up_genes, length)
unique_up_counts  

