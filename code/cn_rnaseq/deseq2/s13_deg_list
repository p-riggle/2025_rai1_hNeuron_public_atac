# load the restables
library(tibble)
library(clusterProfiler)
library(org.Hs.eg.db)

# Define time points and genotypes
timepoints <- c("d0", "d20", "d34", "d60")
genotypes <- c("ko", "het")

# Load all result tables
restables <- list()
for (tp in timepoints) {
  for (geno in genotypes) {
    var_name <- paste0("restbl_", tp, "_", geno)
    file_path <- paste0("results/cn_rnaseq/deseq2/rstbl_", tp, "_wt.vs.", geno, ".txt")
    restables[[var_name]] <- read.table(file_path, sep = "\t", header = TRUE, row.names = 1)
  }
}

# see example data 
head(restables[["restbl_d20_ko"]])

# Function to extract DEGs
extract_degs <- function(restbl, direction) {
  if (direction == "up") {
    subset(restbl, padj < 0.05 & log2FoldChange > 1)
  } else {
    subset(restbl, padj < 0.05 & log2FoldChange < -1)
  }
}

# Extract all DEGs
degs <- list()
directions <- c("up", "down")

for (tp in timepoints) {
  for (geno in genotypes) {
    for (dir in directions) {
      var_name <- paste0(dir, "_", tp, "_", geno)
      restbl_name <- paste0("restbl_", tp, "_", geno)
      degs[[var_name]] <- extract_degs(restables[[restbl_name]], dir)
    }
  }
}

# sort DEGs by padj then log2FC
for (tp in timepoints) {
  for (geno in genotypes) {
    # Sort upregulated DEGs (by padj, then by highest log2FC)
    up_name <- paste0("up_", tp, "_", geno)
    degs[[up_name]] <- degs[[up_name]][order(degs[[up_name]]$padj, -degs[[up_name]]$log2FoldChange), ]
    
    # Sort downregulated DEGs (by padj, then by lowest log2FC)
    down_name <- paste0("down_", tp, "_", geno)
    degs[[down_name]] <- degs[[down_name]][order(degs[[down_name]]$padj, degs[[down_name]]$log2FoldChange), ]
  }
}


# make the lists into tibbles
deg_tibbles <- lapply(degs, function(x) as_tibble(x, rownames = "gene"))  

str(deg_tibbles)

# write the tibbles to files
for (name in names(deg_tibbles)) {
  write.table(deg_tibbles[[name]], file = paste0("results/cn_rnaseq/deseq2/", name, ".txt"), sep = "\t", quote = FALSE, row.names = FALSE)
}

# write the tibbles into excel file with multiple sheets
# install.packages("openxlsx")  # Uncomment if openxlsx is not installed
library(openxlsx)

wb <- createWorkbook()

for (name in names(deg_tibbles)) {
  addWorksheet(wb, name)
  writeData(wb, name, deg_tibbles[[name]])
}

saveWorkbook(wb, file = "results/cn_rnaseq/deseq2/degs.xlsx", overwrite = TRUE)

# identify genes that overlap in het and ko at each timepoint
overlap_genes <- list()
for (tp in timepoints) {
  up_ko <- degs[[paste0("up_", tp, "_ko")]]
  up_het <- degs[[paste0("up_", tp, "_het")]]
  down_ko <- degs[[paste0("down_", tp, "_ko")]]
  down_het <- degs[[paste0("down_", tp, "_het")]]
  overlap_up <- intersect(rownames(up_ko), rownames(up_het))
  overlap_down <- intersect(rownames(down_ko), rownames(down_het))
  overlap_genes[[tp]] <- list(up = overlap_up, down = overlap_down)
}
overlap_genes
# write overlap genes to excel file with multiple sheets
wb_overlap <- createWorkbook()
for (tp in timepoints) {
  addWorksheet(wb_overlap, paste0(tp, "_up"))
  writeData(wb_overlap, paste0(tp, "_up"), as.data.frame(overlap_genes[[tp]]$up), colNames = FALSE)
  addWorksheet(wb_overlap, paste0(tp, "_down"))
  writeData(wb_overlap, paste0(tp, "_down"), as.data.frame(overlap_genes[[tp]]$down), colNames = FALSE)
}
saveWorkbook(wb_overlap, file = "results/cn_rnaseq/deseq2/degs_het-ko_common.xlsx", overwrite = TRUE)

# count number of overlapping genes at each timepoint
overlap_counts <- sapply(overlap_genes, function(x) sapply(x, length))
overlap_counts

