# extract genes with each intersection pattern
intersection_patterns <- list()
for (i in 1:(2^length(timepoints)-1)) {
  pattern <- as.integer(intToBits(i))[1:length(timepoints)]
  included_tps <- timepoints[which(pattern == 1)]
  excluded_tps <- timepoints[which(pattern == 0)]
  
  included_genes <- Reduce(intersect, lapply(included_tps, function(tp) as.character(deg_tibbles[[paste0("up_", tp, "_ko")]]$gene)))
  if (length(excluded_tps) > 0) {
    excluded_genes <- unlist(lapply(excluded_tps, function(tp) as.character(deg_tibbles[[paste0("up_", tp, "_ko")]]$gene)))
    final_genes <- setdiff(included_genes, excluded_genes)
  } else {
    final_genes <- included_genes
  }
  
  pattern_name <- paste0(ifelse(pattern == 1, "1", "0"), collapse = "")
  intersection_patterns[[pattern_name]] <- final_genes
}

str(intersection_patterns)
head(intersection_patterns)

# generate of list of genes for each intersection pattern
intersection_patterns_list <- lapply(intersection_patterns, unique)
intersection_patterns_list

# count number of genes in each intersection pattern
intersection_pattern_counts <- sapply(intersection_patterns_list, length)
intersection_pattern_counts

# convert symbols to entrez ids
# BiocManager::install("org.Hs.eg.db")
library(org.Hs.eg.db)
intersection_up_genes <- lapply(intersection_patterns_list, function(x) {
    entrez <- mapIds(org.Hs.eg.db, x, "ENTREZID", "SYMBOL")
    entrez <- unlist(entrez)
    entrez <- entrez[!is.na(entrez)]
    return(entrez)
})
intersection_up_genes
str(intersection_up_genes)

# count number of genes that are successfully converted to entrez ids for each pattern
intersection_up_counts <- sapply(intersection_up_genes, length)
intersection_up_counts

